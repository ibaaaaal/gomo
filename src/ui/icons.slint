export component MonitorIcon {
    in property <color> stroke-color: #3E6947;
    width: 32px;
    height: 30px;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 32;
        viewbox-height: 30;
        commands: "M 2 3 L 30 3 L 30 21 L 2 21 Z M 16 21 L 16 27 M 10 27 L 22 27";
        stroke: root.stroke-color;
        stroke-width: 1.8px;
        fill: #00000000;
    }
}

