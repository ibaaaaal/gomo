import { Theme } from "theme.slint";
import { BackArrowIcon } from "icons.slint";

component DataAction inherits Rectangle {
    in property <string> label;
    in property <bool> dark: false;
    callback clicked();

    height: 40px;
    border-radius: 10px;
    background: action-touch.has-hover ? (root.dark ? #41684B : #E5ECE7) : (root.dark ? Theme.rest-disc : #F3F7F4);

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: space-between;

        Text {
            text: root.label;
            color: root.dark ? #FFFFFF : Theme.work-text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    action-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DataView inherits Rectangle {
    in property <bool> is-dark: false;
    in property <string> data-path;
    in property <string> status-text;

    callback back-clicked();
    callback export-csv();
    callback export-json();
    callback import-json();
    callback backup-now();
    callback restore-backup();

    width: 100%;
    height: 100%;

    property <color> text-col: is-dark ? #FFFFFF : Theme.work-text;
    property <color> muted-col: is-dark ? #A5CDAF : #6C8571;

    VerticalLayout {
        padding: 20px;
        spacing: 10px;
        alignment: start;

        HorizontalLayout {
            height: 32px;
            alignment: space-between;

            Rectangle {
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: back-touch.has-hover ? (root.is-dark ? #41684B : #EDF2EE) : #00000000;

                BackArrowIcon {
                    stroke-color: root.text-col;
                }

                back-touch := TouchArea {
                    clicked => { root.back-clicked(); }
                }
            }

            Text {
                text: "Data";
                color: root.text-col;
                font-size: 15px;
                font-weight: 700;
                letter-spacing: 0.5px;
                vertical-alignment: center;
            }

            Rectangle { width: 32px; }
        }

        Text {
            text: "Data folder";
            color: root.muted-col;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.8px;
        }

        Text {
            text: root.data-path;
            color: root.text-col;
            font-size: 9px;
            overflow: elide;
        }

        DataAction {
            label: "Export Sessions CSV";
            dark: root.is-dark;
            clicked => { root.export-csv(); }
        }
        DataAction {
            label: "Export Backup JSON";
            dark: root.is-dark;
            clicked => { root.export-json(); }
        }
        DataAction {
            label: "Import Backup (replace)";
            dark: root.is-dark;
            clicked => { root.import-json(); }
        }
        DataAction {
            label: "Backup Now";
            dark: root.is-dark;
            clicked => { root.backup-now(); }
        }
        DataAction {
            label: "Restore Last Backup";
            dark: root.is-dark;
            clicked => { root.restore-backup(); }
        }

        Text {
            text: root.status-text;
            color: root.muted-col;
            font-size: 10px;
            wrap: word-wrap;
        }

        Text {
            text: "Import replaces the current statistics and creates a backup first. Settings are not included.";
            color: root.muted-col;
            font-size: 9px;
            wrap: word-wrap;
        }
    }
}
