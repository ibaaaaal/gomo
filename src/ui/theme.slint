export global Theme {
    // study
    out property <color> work-bg: #FFFFFF;
    out property <color> work-primary: #3E6947;
    out property <color> work-track: #E2E8E3;
    out property <color> work-text: #223827;
    out property <color> work-muted: #829A86;
    out property <color> work-dot-inactive: #D0D8D1;

    // rest
    out property <color> rest-bg: #4A7654;
    out property <color> rest-disc: #3F6647;
    out property <color> rest-track: #3F6647;
    out property <color> rest-primary: #FFFFFF;
    out property <color> rest-text: #FFFFFF;
    out property <color> rest-muted: #95BCA0;
    out property <color> rest-dot-inactive: #6E9677;

    // deep rest
    out property <color> deep-rest-bg: #375F4B;
    out property <color> deep-rest-disc: #2E513F;

    // heatmap scale, light
    out property <color> heat-0: #E2E8E3;
    out property <color> heat-1: #C9DCCD;
    out property <color> heat-2: #9DC2A4;
    out property <color> heat-3: #6E9C77;
    out property <color> heat-4: #3E6947;

    // heatmap scale, dark
    out property <color> heat-dark-0: #3F6647;
    out property <color> heat-dark-1: #557D5E;
    out property <color> heat-dark-2: #6E9677;
    out property <color> heat-dark-3: #95BCA0;
    out property <color> heat-dark-4: #FFFFFF;
}
